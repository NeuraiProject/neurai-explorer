# Copy to .env and adjust before the first start:
#   cp .env.example .env
# Every value below is optional; docker-compose.yml uses the same defaults when
# a variable is missing.

# ---------------------------------------------------------------------------
# Neurai node (neuraiproject/neurai-node image from Docker Hub)
# ---------------------------------------------------------------------------

# Docker Hub tag to run. See https://hub.docker.com/r/neuraiproject/neurai-node/tags
NEURAI_IMAGE_TAG=v1.0.6

# RPC credentials shared by the node, the syncer and the frontend. Change them
# for any deployment that is not local.
RPC_USER=neuraiuser
RPC_PASS=neuraipassword

# RPC server capacity. The syncer issues many concurrent requests during the
# initial sync; keep these high.
RPC_WORKQUEUE=1024
RPC_THREADS=16

# Database cache in MB for the node. Raising it (e.g. 1024 or more) speeds up
# the initial sync noticeably if the host has the RAM.
NODE_DB_CACHE=128

# The node settings above (and the fixed ones in docker-compose.yml: indexes,
# REST, wallet disabled, no inbound P2P) are written to /data/neurai.conf only
# on the first start of an empty node-data volume. To change an existing node,
# edit that file inside the volume and restart the node service.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Used by postgres, the syncer and the frontend to build DATABASE_URL. Change
# the password for any deployment that is not local. Changing user or database
# name after the first start requires recreating the pg-data volume.
POSTGRES_USER=neurai
POSTGRES_PASSWORD=neurai123
POSTGRES_DB=neuraidb

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Host port where the explorer UI is published.
FRONTEND_PORT=3333
