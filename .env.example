# Copy to .env and adjust before the first start:
#   cp .env.example .env
# Every value below is optional; docker-compose.yml uses the same defaults when
# a variable is missing.

# ---------------------------------------------------------------------------
# Neurai node (neuraiproject/neurai-node image from Docker Hub)
# ---------------------------------------------------------------------------

# Docker Hub tag to run. See https://hub.docker.com/r/neuraiproject/neurai-node/tags
NEURAI_IMAGE_TAG=v1.0.6

# RPC credentials shared by the node, the syncer and the frontend. Change them
# for any deployment that is not local.
RPC_USER=neuraiuser
RPC_PASS=neuraipassword

# RPC server capacity. The syncer keeps ~50 requests in flight during the
# initial sync (16 block fetches + 32 input fetches, see syncer/config.json);
# these HTTP worker threads are shared by RPC and REST.
RPC_WORKQUEUE=1024
RPC_THREADS=64

# Database cache in MB for the node's own chain state (UTXO/leveldb). Raising
# it (e.g. 1024 or more) speeds up the node's initial block download and
# reindex; the explorer's sync reads blocks through REST/RPC and does not
# depend on it.
NODE_DB_CACHE=128

# The node settings above (and the fixed ones in docker-compose.yml: indexes,
# REST, wallet disabled, no inbound P2P) are written to /data/neurai.conf only
# on the first start of an empty node-data volume. To change an existing node,
# edit that file inside the volume and restart the node service.

# ---------------------------------------------------------------------------
# Syncer
# ---------------------------------------------------------------------------

# Fetch blocks and previous transactions through the node's REST interface
# instead of RPC (faster, parallel). Requires rest=1 on the node, which the
# docker-compose node has. Set to 0 to force RPC only.
RPC_USE_REST=1

# When a syncer upgrade changes the database layout (schema version), it
# refuses to start on a populated database. Set this to 1 for one start to
# wipe the indexed data and resync from genesis (takes about as long as the
# initial sync); set it back to 0 afterwards.
RESYNC_ON_SCHEMA_CHANGE=0

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Used by postgres, the syncer and the frontend to build DATABASE_URL. Change
# the password for any deployment that is not local. Changing user or database
# name after the first start requires recreating the pg-data volume.
POSTGRES_USER=neurai
POSTGRES_PASSWORD=neurai123
POSTGRES_DB=neuraidb

# PostgreSQL memory. shared_buffers ~25% of the RAM given to the database,
# effective_cache_size ~ RAM available for OS cache + shared_buffers.
# On a large host (e.g. 64+ GB RAM, NVMe) use something like 8GB / 48GB.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB

# Checkpoint spacing. The initial sync writes tens of GB of WAL; each
# checkpoint forces full-page writes of every index page touched afterwards,
# so fewer checkpoints = much less I/O. Needs that much free disk for WAL
# while syncing (it is recycled afterwards). Large host: 32GB / 30min.
PG_MAX_WAL_SIZE=8GB
PG_CHECKPOINT_TIMEOUT=15min
# WAL buffer; the automatic value (16MB) is what bulk inserts wait on.
PG_WAL_BUFFERS=64MB

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Host address and port where the explorer UI is published. It binds to
# loopback by default so only a reverse proxy on the same host (nginx) can
# reach it; Docker published ports bypass the host firewall, so do not rely on
# ufw for this. Use FRONTEND_BIND=0.0.0.0 to expose it directly.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3333
